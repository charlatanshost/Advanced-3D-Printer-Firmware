{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Printer Host GUI",
            "type": "node-terminal",
            "request": "launch",
            "command": "cargo run",
            "cwd": "${workspaceFolder}/printer-host"
        },
        {
            "name": "Simulate example print",
            "type": "node-terminal",
            "request": "launch",
            "command": "cargo run -- --simulate ../gcode/example.gcode",
            "cwd": "${workspaceFolder}/printer-host"
        }
    ]
}
